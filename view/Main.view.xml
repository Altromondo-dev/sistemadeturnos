<mvc:View controllerName="transener.sistemadeturnos.controller.Main" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc"
	displayBlock="true" xmlns:t="sap.ui.table" xmlns="sap.m">
	<Shell id="shell">
		<App id="app">
			<pages>
				<Page id="page" title="{i18n>title}">
					<Panel expandable="true" expanded="true">
						<FlexBox>
							<VBox width="50%" alignItems="End">
								<HBox alignItems="Center">
									<Label text="{i18n>region}:" class="sapUiTinyMarginEnd"/>
									<ComboBox width="20rem" id="Estaciones" selectionChange=".loadGrupoPlanificador"
										items="{ path: 'RegionesJsonModel>/Regiones', templateShareable: true }">
										<core:Item key="{RegionesJsonModel>Werks}" text="{RegionesJsonModel>Name1}"/>
									</ComboBox>
								</HBox>
								<HBox alignItems="Center">
									<Label text="{i18n>ET}:" class="sapUiTinyMarginEnd"/>
									<MultiComboBox width="20rem" selectionChange=".changeUbicacion" items="{ path: 'EquiposJsonModel>/Equipos', templateShareable: true }">
										<core:Item key="{EquiposJsonModel>CodigoEquipo}" text="{EquiposJsonModel>CodigoEquipo} - {EquiposJsonModel>DescEquipo}"/>
									</MultiComboBox>
								</HBox>
								<HBox alignItems="Center">
									<Label text="{i18n>equipmentCAM}:" class="sapUiTinyMarginEnd"/>
									<ComboBox width="20rem"/>
								</HBox>
								<HBox alignItems="Center">
									<Label text="{i18n>statusCAM}:" class="sapUiTinyMarginEnd"/>
									<ComboBox width="20rem"/>
								</HBox>
							</VBox>
							<VBox width="50%" alignItems="End">
								<HBox alignItems="Center">
									<Label text="{i18n>date}:" class="sapUiTinyMarginEnd"/>
									<DateTimePicker id="date"/>
								</HBox>
								<HBox alignItems="Center">
									<Label text="{i18n>equipRecierre}:" class="sapUiTinyMarginEnd"/>
									<ComboBox/>
								</HBox>
								<HBox alignItems="Center">
									<Label text="{i18n>equipDisparo}:" class="sapUiTinyMarginEnd"/>
									<ComboBox/>
								</HBox>
							</VBox>
						</FlexBox>
					</Panel>
					<FlexBox height="100px">
						<VBox width="20%" justifyContent="SpaceAround" alignItems="Center">
							<Title class="textColor" text="FECHA" titleStyle="H2"/>
							<Title class="textColor" text="27/06/2024" titleStyle="H3"/>
						</VBox>
						<VBox width="25%" justifyContent="SpaceAround">
							<HBox justifyContent="SpaceBetween">
								<Text class="textColor" text="Cantidad de LLTT con maniobras"/>
								<Text class="textColor counts" wrapping="false" text="{countsModel>/LTWithManouvers}"/>
							</HBox>
							<HBox justifyContent="SpaceBetween">
								<Text class="textColor" text="Cantidad de LLTT s/maniobras"/>
								<Text class="textColor counts" text="{countsModel>/LTWithoutManouvers}"/>
							</HBox>
							<HBox justifyContent="SpaceBetween">
								<Text class="textColor" text="Cantidad de TcT"/>
								<Text class="textColor counts" text="{countsModel>/TCT}"/>
							</HBox>
						</VBox>
						<VBox justifyContent="Center">
							<NumericContent value="{countsModel>/Total}" valueColor="Error"/>
						</VBox>
						<HBox width="60%" class="border" alignItems="End">
							<HBox class="border sapUiTinyMargin" width="100%" justifyContent="SpaceAround">
								<Input placeholder="{i18n>fastSearch}"/>
								<HBox width="50%" class="btnContainer" justifyContent="SpaceBetween">
									<Button icon="sap-icon://search" text="Buscar" press="onFilter"/>
									<Button icon="sap-icon://clear-filter" text="Limpiar Filtros" press="onClearFilter"/>
									<Button icon="sap-icon://search"/>
								</HBox>
							</HBox>
						</HBox>
					</FlexBox>
					<t:Table id="auditTable" class="customTable" rows='{path:"LicencesListJsonModel>/"}' selectionMode="None" visibleRowCount='12'>
						<t:columns>
							<t:Column>
								<t:template>
									<VBox>
										<Button icon="sap-icon://expand-group" press="onShowDetailsPress" visible="{= !${LicencesListJsonModel>nested} }"/>
									</VBox>
								</t:template>
							</t:Column>
							<t:Column id="equipment" width="100px" class="customColumnBackground" hAlign="Center" sortProperty="equipment" filterProperty="equipment">
								<Label text="{i18n>equipment}"/>
								<t:template>
									<Text text="{LicencesListJsonModel>Equnr}" wrapping="false" class="text-bold" visible="{= !${LicencesListJsonModel>nested} }"/>
								</t:template>
							</t:Column>
							<t:Column id="status" hAlign="Center" sortProperty="status" filterProperty="status">
								<Label text="{i18n>status}" class="back"/>
								<t:template>
									<Text text="{ path: 'LicencesListJsonModel>Equstat' ,formatter: '.FormatterHelper.getEstado' }" wrapping="false"/>
								</t:template>
							</t:Column>
							<t:Column hAlign="Center" width="200px" sortProperty="Tipinterv" filterProperty="JobCond">
								<Label text="{i18n>conditionWork}"/>
								<t:template>
									<Text text="{path: 'LicencesListJsonModel>Jobcond', formatter: '.FormatterHelper.getJobCond'}" textAlign="Center" wrapping="true"/>
									<!--<Text text="{path: 'LicencesListJsonModel>Jobcond'}" wrapping="false"/>-->
								</t:template>
							</t:Column>
							<t:Column id="initHour" hAlign="End" sortProperty="initHour" filterProperty="initHour">
								<Label text="{i18n>initHour}" textAlign="Center"/>
								<t:template>
									<Text text="{LicencesListJsonModel>Solbeg}" wrapping="false"/>
								</t:template>
							</t:Column>
							<t:Column id="toDoWork" width="350px" sortProperty="toDoWork" filterProperty="toDoWork">
								<Label text="{i18n>toDoWork}"/>
								<t:template>
									<Text text="{LicencesListJsonModel>Comments}" wrapping="true"/>
								</t:template>
							</t:Column>
							<t:Column id="region" width="200px" hAlign="Center" sortProperty="Werks" filterProperty="Werks">
								<Label text="{i18n>region}"/>
								<t:template>
									<Text text="{path: 'LicencesListJsonModel>Werks', formatter: '.FormatterHelper.getRegiones'}" textAlign="Center" wrapping="true"/>
								</t:template>
							</t:Column>
							<t:Column id="console" hAlign="Center" sortProperty="Id" filterProperty="Id">
								<Label text="{i18n>console}"/>
								<t:template>
									<Text text="{LicencesListJsonModel>Id}" wrapping="false"/>
								</t:template>
							</t:Column>
							<t:Column id="shift" hAlign="End" sortProperty="shift" filterProperty="shift">
								<Label text="{i18n>shift}"/>
								<t:template>
									<Text text="{shift}" wrapping="false" class="text-bold"/>
								</t:template>
							</t:Column>
							<t:Column id="comment" hAlign="End" sortProperty="comment" filterProperty="comment">
								<Label text="{i18n>comment}"/>
								<t:template>
									<Text text="{LicencesListJsonModel>Prgcomments}" wrapping="true"/>
								</t:template>
							</t:Column>
						</t:columns>
					</t:Table>
					<content/>
					<footer>
						<OverflowToolbar>
							<Button text="{i18n>reports}" press="onReportsPress"/>
							<ToolbarSpacer/>
							<Button icon="sap-icon://create-form" text="{i18n>createShift}" press="onCreateShiftPress"/>
							<Button icon="sap-icon://email" text="{i18n>sendEmail}" press="onSendEmailPress"/>
						</OverflowToolbar>
					</footer>
				</Page>
			</pages>
		</App>
	</Shell>
</mvc:View>